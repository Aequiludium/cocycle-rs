{
  "name": "Protect main",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/main"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "Format, lint and docs",
            "integration_id": 15368
          },
          {
            "context": "Test (ubuntu-latest)",
            "integration_id": 15368
          },
          {
            "context": "Test (macos-latest)",
            "integration_id": 15368
          },
          {
            "context": "Test (windows-latest)",
            "integration_id": 15368
          },
          {
            "context": "Minimum Rust (1.91)",
            "integration_id": 15368
          },
          {
            "context": "Package and packaged example",
            "integration_id": 15368
          },
          {
            "context": "Native C++ reference comparisons",
            "integration_id": 15368
          },
          {
            "context": "Native diagram-distance references",
            "integration_id": 15368
          }
        ]
      }
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": false
      }
    }
  ]
}
